{
  "name": "scala-analyzer",
  "displayName": "Scala (scala-analyzer)",
  "description": "Scala diagnostics, completion, formatting, navigation, symbols and semantic colors from the IntelliJ Scala plugin, through the scala-analyzer language server.",
  "version": "0.5.1",
  "publisher": "brurdgz",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BruRdgz/scala-analyzer"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionDependencies": [
    "scala-lang.scala"
  ],
  "activationEvents": [
    "onLanguage:scala",
    "onLanguage:java",
    "onDebugResolve:scala-analyzer",
    "workspaceContains:pom.xml",
    "workspaceContains:build.gradle",
    "workspaceContains:build.gradle.kts",
    "workspaceContains:settings.gradle",
    "workspaceContains:settings.gradle.kts"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "scala-analyzer",
      "properties": {
        "scalaAnalyzer.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to bin/scala-analyzer of a built distribution (sbt dist)."
        },
        "scalaAnalyzer.javaHome": {
          "type": "string",
          "default": "",
          "description": "JDK 25 home for the server. Empty: the JAVA_HOME of VS Code's environment."
        },
        "scalaAnalyzer.buildJavaHome": {
          "type": "string",
          "default": "",
          "description": "The JDK that runs Maven and Gradle for the import. Empty: the JAVA_HOME VS Code was started with."
        },
        "scalaAnalyzer.debugLog": {
          "type": "boolean",
          "default": false,
          "description": "Log every request the server answers, with its time (SCALA_ANALYZER_LOG=debug). Takes effect when the server restarts."
        },
        "scalaAnalyzer.inlayHints.methodResultTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show the inferred result type of a def that has none."
        },
        "scalaAnalyzer.inlayHints.memberVariableTypes": {
          "type": "boolean",
          "default": false,
          "description": "Show the inferred type of a val or var of a class, object or trait that has none."
        },
        "scalaAnalyzer.inlayHints.localVariableTypes": {
          "type": "boolean",
          "default": false,
          "description": "Show the inferred type of a local val or var that has none."
        },
        "scalaAnalyzer.inlayHints.obviousTypes": {
          "type": "boolean",
          "default": false,
          "description": "Show inferred types also where the initializer already makes them obvious (val name = \"x\")."
        },
        "scalaAnalyzer.inlayHints.parameterNames": {
          "type": "boolean",
          "default": false,
          "description": "Show parameter names before the arguments whose meaning is unclear."
        },
        "scalaAnalyzer.inlayHints.methodChains": {
          "type": "boolean",
          "default": true,
          "description": "Show the type after each call of a method chain."
        },
        "scalaAnalyzer.inlayHints.implicits": {
          "type": "boolean",
          "default": true,
          "description": "Show implicit arguments, using arguments and implicit conversions. The IntelliJ Scala plugin leaves these off until toggled."
        },
        "scalaAnalyzer.inlayHints.xRay": {
          "type": "boolean",
          "default": false,
          "description": "X-Ray mode of the IntelliJ Scala plugin, which the IDE shows while Ctrl is held: also show the types of all definitions, of lambda parameters, placeholders and pattern variables, parameter names, by-name arguments, apply calls and method chains. Scala 3 files, whose errors come from the compiler, show type and method chain hints only in this mode. The command scala-analyzer: Toggle X-Ray flips it."
        }
      }
    },
    "configurationDefaults": {
      "[scala]": {
        "editor.defaultFormatter": "brurdgz.scala-analyzer"
      }
    },
    "breakpoints": [
      {
        "language": "scala"
      },
      {
        "language": "java"
      }
    ],
    "debuggers": [
      {
        "type": "scala-analyzer",
        "label": "Scala (scala-analyzer)",
        "languages": [
          "scala",
          "java"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "buildTarget"
            ],
            "properties": {
              "buildTarget": {
                "type": "string",
                "description": "The build target to compile and debug, as the server names it: the workspace's file URI and the target's id, such as file:///project#app/Compile for a main class and file:///project#core/Test for a test suite (the Scala Build view lists the ids)."
              },
              "mainClass": {
                "type": "string",
                "description": "The class with the main method to debug, by its JVM name (app.Main). Use this or testClass."
              },
              "testClass": {
                "type": "string",
                "description": "The test suite to debug, by its class name (core.ExampleSuite); for JUnit, its binary name. Use this or mainClass."
              },
              "testName": {
                "type": "string",
                "description": "The test of the suite to debug, as the Run test lens names it; every test of the suite when empty."
              },
              "framework": {
                "type": "string",
                "enum": [
                  "junit4",
                  "junit5",
                  "munit",
                  "scalatest",
                  "specs2",
                  "utest"
                ],
                "description": "The test framework of testClass, which picks the runner."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The arguments of mainClass. A testClass takes none: its runner's arguments are the selection."
              },
              "jvmOptions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "JVM options added after the build's, such as -Xmx2g or -Dkey=value."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables added to the build's; one of the same name replaces the build's."
              }
            }
          },
          "attach": {
            "required": [
              "buildTarget",
              "port"
            ],
            "properties": {
              "buildTarget": {
                "type": "string",
                "description": "The build target the running program was built from, as the server names it (file:///project#app/Compile). The server compiles it, as for a launch, to find the sources of the program's classes."
              },
              "hostName": {
                "type": "string",
                "default": "localhost",
                "description": "The host where the program's JDWP agent listens."
              },
              "port": {
                "type": "number",
                "description": "The port where the program's JDWP agent listens (-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005)."
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Scala: debug a main class",
            "description": "Launch a main class with the debugger.",
            "body": {
              "type": "scala-analyzer",
              "request": "launch",
              "name": "Debug ${2:app.Main}",
              "buildTarget": "${1:file:///project#app/Compile}",
              "mainClass": "${2:app.Main}"
            }
          },
          {
            "label": "Scala: debug a test suite",
            "description": "Launch a test suite with the debugger.",
            "body": {
              "type": "scala-analyzer",
              "request": "launch",
              "name": "Debug ${2:core.ExampleSuite}",
              "buildTarget": "${1:file:///project#core/Test}",
              "testClass": "${2:core.ExampleSuite}",
              "framework": "${3|munit,scalatest,specs2,utest,junit4,junit5|}"
            }
          },
          {
            "label": "Scala: attach to a running JVM",
            "description": "Attach the debugger to a JVM started with a JDWP agent.",
            "body": {
              "type": "scala-analyzer",
              "request": "attach",
              "name": "Attach to ${2:localhost}:${3:5005}",
              "buildTarget": "${1:file:///project#app/Compile}",
              "hostName": "${2:localhost}",
              "port": "^${3:5005}"
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "scala-analyzer",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "compile"
            ],
            "description": "The build task to run: compile builds every build target and reports its diagnostics in the Problems panel."
          }
        }
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "scalaAnalyzerInspection",
          "title": "Inspection Results",
          "icon": "$(search)"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "scalaAnalyzer.buildTargets",
          "name": "Scala Build",
          "when": "scalaAnalyzer.active"
        }
      ],
      "scalaAnalyzerInspection": [
        {
          "id": "scalaAnalyzer.inspectionResults",
          "name": "Inspection Results",
          "when": "scalaAnalyzer.active"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "scalaAnalyzer.buildTargets",
        "contents": "No build targets yet. They appear here once the build has been imported."
      },
      {
        "view": "scalaAnalyzer.inspectionResults",
        "contents": "No inspection results yet.\n[Inspect Code](command:scalaAnalyzer.inspect)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "scalaAnalyzer.typeInfo",
          "when": "editorLangId == scala || editorLangId == java",
          "group": "navigation"
        },
        {
          "command": "scalaAnalyzer.goToSuper",
          "when": "editorLangId == scala || editorLangId == java",
          "group": "navigation"
        },
        {
          "command": "scalaAnalyzer.goToTest",
          "when": "editorLangId == scala || editorLangId == java",
          "group": "navigation"
        },
        {
          "command": "scalaAnalyzer.chooseMembersToOverride",
          "when": "editorLangId == scala || editorLangId == java",
          "group": "1_modification"
        }
      ],
      "view/title": [
        {
          "command": "scalaAnalyzer.compile",
          "when": "view == scalaAnalyzer.buildTargets",
          "group": "navigation"
        },
        {
          "command": "scalaAnalyzer.reimport",
          "when": "view == scalaAnalyzer.buildTargets",
          "group": "navigation"
        },
        {
          "command": "scalaAnalyzer.inspect",
          "when": "view == scalaAnalyzer.buildTargets",
          "group": "navigation"
        },
        {
          "command": "scalaAnalyzer.inspect",
          "when": "view == scalaAnalyzer.inspectionResults",
          "group": "navigation@1"
        },
        {
          "command": "scalaAnalyzer.clearInspection",
          "when": "view == scalaAnalyzer.inspectionResults",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "scalaAnalyzer.compileTarget",
          "when": "view == scalaAnalyzer.buildTargets && viewItem == target",
          "group": "inline"
        },
        {
          "command": "scalaAnalyzer.applyInspectionFix",
          "when": "view == scalaAnalyzer.inspectionResults && viewItem == problem",
          "group": "inline@1"
        },
        {
          "command": "scalaAnalyzer.suppressInspection",
          "when": "view == scalaAnalyzer.inspectionResults && viewItem == problem",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "scalaAnalyzer.applyInspectionFix",
          "when": "false"
        },
        {
          "command": "scalaAnalyzer.suppressInspection",
          "when": "false"
        },
        {
          "command": "scalaAnalyzer.typeInfo",
          "when": "editorLangId == scala || editorLangId == java"
        },
        {
          "command": "scalaAnalyzer.goToSuper",
          "when": "editorLangId == scala || editorLangId == java"
        },
        {
          "command": "scalaAnalyzer.goToTest",
          "when": "editorLangId == scala || editorLangId == java"
        },
        {
          "command": "scalaAnalyzer.chooseMembersToOverride",
          "when": "editorLangId == scala || editorLangId == java"
        },
        {
          "command": "scalaAnalyzer.compileTarget",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "scalaAnalyzer.toggleXRay",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x",
        "when": "editorTextFocus && editorLangId == scala"
      }
    ],
    "commands": [
      {
        "command": "scalaAnalyzer.menu",
        "title": "Show Menu",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.compile",
        "title": "Compile Build",
        "category": "scala-analyzer",
        "icon": "$(tools)"
      },
      {
        "command": "scalaAnalyzer.compileTarget",
        "title": "Compile Target",
        "category": "scala-analyzer",
        "icon": "$(tools)"
      },
      {
        "command": "scalaAnalyzer.reimport",
        "title": "Reimport Build",
        "category": "scala-analyzer",
        "icon": "$(sync)"
      },
      {
        "command": "scalaAnalyzer.inspect",
        "title": "Inspect Code",
        "category": "scala-analyzer",
        "icon": "$(search)"
      },
      {
        "command": "scalaAnalyzer.clearInspection",
        "title": "Clear Inspection Results",
        "category": "scala-analyzer",
        "icon": "$(clear-all)"
      },
      {
        "command": "scalaAnalyzer.applyInspectionFix",
        "title": "Apply Fix",
        "category": "scala-analyzer",
        "icon": "$(wrench)"
      },
      {
        "command": "scalaAnalyzer.suppressInspection",
        "title": "Suppress Inspection",
        "category": "scala-analyzer",
        "icon": "$(eye-closed)"
      },
      {
        "command": "scalaAnalyzer.restart",
        "title": "Restart Server",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.typeInfo",
        "title": "Show Type Info",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.goToSuper",
        "title": "Go to Super",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.goToTest",
        "title": "Go to Test",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.chooseMembersToOverride",
        "title": "Override Members…",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.toggleXRay",
        "title": "Toggle X-Ray",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.showStatus",
        "title": "Show Status",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.showLog",
        "title": "Show Log File",
        "category": "scala-analyzer"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0"
  },
  "scripts": {
    "check": "node --check extension.js && node --check buildTargets.js && node --check inspect.js && node --check inspectionTree.js && node --check tests.js",
    "package": "vsce package",
    "test:installed": "node test/run.js"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
