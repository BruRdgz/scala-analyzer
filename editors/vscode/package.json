{
  "name": "scala-psi-host",
  "displayName": "Scala (scala-psi-host)",
  "description": "Scala diagnostics, completion, formatting, navigation, symbols and semantic colors from the IntelliJ Scala plugin, through the scala-psi-host language server.",
  "version": "0.1.0",
  "publisher": "brurdgz",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BruRdgz/scala-psi-host"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionDependencies": [
    "scala-lang.scala"
  ],
  "activationEvents": [
    "onLanguage:scala"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "scala-psi-host",
      "properties": {
        "scalaPsiHost.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to bin/scala-psi-host of a built distribution (sbt dist)."
        },
        "scalaPsiHost.javaHome": {
          "type": "string",
          "default": "",
          "description": "JDK 25 home for the server. Empty: the JAVA_HOME of VS Code's environment."
        },
        "scalaPsiHost.debugLog": {
          "type": "boolean",
          "default": false,
          "description": "Log every request the server answers, with its time (SCALA_PSI_HOST_LOG=debug). Takes effect when the server restarts."
        }
      }
    },
    "configurationDefaults": {
      "[scala]": {
        "editor.defaultFormatter": "brurdgz.scala-psi-host"
      }
    },
    "commands": [
      {
        "command": "scalaPsiHost.showStatus",
        "title": "Show Status",
        "category": "scala-psi-host"
      },
      {
        "command": "scalaPsiHost.showLog",
        "title": "Show Log File",
        "category": "scala-psi-host"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0"
  },
  "scripts": {
    "check": "node --check extension.js",
    "package": "vsce package",
    "test:installed": "node test/run.js"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
