{
  "name": "scala-analyzer",
  "displayName": "Scala (scala-analyzer)",
  "description": "Scala diagnostics, completion, formatting, navigation, symbols and semantic colors from the IntelliJ Scala plugin, through the scala-analyzer language server.",
  "version": "0.3.1",
  "publisher": "brurdgz",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BruRdgz/scala-analyzer"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionDependencies": [
    "scala-lang.scala"
  ],
  "activationEvents": [
    "onLanguage:scala"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "scala-analyzer",
      "properties": {
        "scalaAnalyzer.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to bin/scala-analyzer of a built distribution (sbt dist)."
        },
        "scalaAnalyzer.javaHome": {
          "type": "string",
          "default": "",
          "description": "JDK 25 home for the server. Empty: the JAVA_HOME of VS Code's environment."
        },
        "scalaAnalyzer.debugLog": {
          "type": "boolean",
          "default": false,
          "description": "Log every request the server answers, with its time (SCALA_ANALYZER_LOG=debug). Takes effect when the server restarts."
        },
        "scalaAnalyzer.inlayHints.methodResultTypes": {
          "type": "boolean",
          "default": true,
          "description": "Show the inferred result type of a def that has none."
        },
        "scalaAnalyzer.inlayHints.memberVariableTypes": {
          "type": "boolean",
          "default": false,
          "description": "Show the inferred type of a val or var of a class, object or trait that has none."
        },
        "scalaAnalyzer.inlayHints.localVariableTypes": {
          "type": "boolean",
          "default": false,
          "description": "Show the inferred type of a local val or var that has none."
        },
        "scalaAnalyzer.inlayHints.obviousTypes": {
          "type": "boolean",
          "default": false,
          "description": "Show inferred types also where the initializer already makes them obvious (val name = \"x\")."
        },
        "scalaAnalyzer.inlayHints.parameterNames": {
          "type": "boolean",
          "default": false,
          "description": "Show parameter names before the arguments whose meaning is unclear."
        },
        "scalaAnalyzer.inlayHints.methodChains": {
          "type": "boolean",
          "default": true,
          "description": "Show the type after each call of a method chain."
        },
        "scalaAnalyzer.inlayHints.implicits": {
          "type": "boolean",
          "default": true,
          "description": "Show implicit arguments, using arguments and implicit conversions. The IntelliJ Scala plugin leaves these off until toggled."
        },
        "scalaAnalyzer.inlayHints.xRay": {
          "type": "boolean",
          "default": false,
          "description": "X-Ray mode of the IntelliJ Scala plugin, which the IDE shows while Ctrl is held: also show the types of all definitions, of lambda parameters, placeholders and pattern variables, parameter names, by-name arguments, apply calls and method chains. Scala 3 files, whose errors come from the compiler, show type and method chain hints only in this mode. The command scala-analyzer: Toggle X-Ray flips it."
        }
      }
    },
    "configurationDefaults": {
      "[scala]": {
        "editor.defaultFormatter": "brurdgz.scala-analyzer"
      }
    },
    "taskDefinitions": [
      {
        "type": "scala-analyzer",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "compile"
            ],
            "description": "The build task to run: compile builds every Scala target and reports its diagnostics in the Problems panel."
          }
        }
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "scalaAnalyzerInspection",
          "title": "Inspection Results",
          "icon": "$(search)"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "scalaAnalyzer.buildTargets",
          "name": "Scala Build",
          "when": "scalaAnalyzer.active"
        }
      ],
      "scalaAnalyzerInspection": [
        {
          "id": "scalaAnalyzer.inspectionResults",
          "name": "Inspection Results",
          "when": "scalaAnalyzer.active"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "scalaAnalyzer.buildTargets",
        "contents": "No build targets yet. They appear here once the build has been imported."
      },
      {
        "view": "scalaAnalyzer.inspectionResults",
        "contents": "No inspection results yet.\n[Inspect Code](command:scalaAnalyzer.inspect)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "scalaAnalyzer.typeInfo",
          "when": "editorLangId == scala",
          "group": "navigation"
        },
        {
          "command": "scalaAnalyzer.goToSuper",
          "when": "editorLangId == scala",
          "group": "navigation"
        },
        {
          "command": "scalaAnalyzer.goToTest",
          "when": "editorLangId == scala",
          "group": "navigation"
        },
        {
          "command": "scalaAnalyzer.chooseMembersToOverride",
          "when": "editorLangId == scala",
          "group": "1_modification"
        }
      ],
      "view/title": [
        {
          "command": "scalaAnalyzer.compile",
          "when": "view == scalaAnalyzer.buildTargets",
          "group": "navigation"
        },
        {
          "command": "scalaAnalyzer.reimport",
          "when": "view == scalaAnalyzer.buildTargets",
          "group": "navigation"
        },
        {
          "command": "scalaAnalyzer.inspect",
          "when": "view == scalaAnalyzer.buildTargets",
          "group": "navigation"
        },
        {
          "command": "scalaAnalyzer.inspect",
          "when": "view == scalaAnalyzer.inspectionResults",
          "group": "navigation@1"
        },
        {
          "command": "scalaAnalyzer.clearInspection",
          "when": "view == scalaAnalyzer.inspectionResults",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "scalaAnalyzer.compileTarget",
          "when": "view == scalaAnalyzer.buildTargets && viewItem == target",
          "group": "inline"
        },
        {
          "command": "scalaAnalyzer.applyInspectionFix",
          "when": "view == scalaAnalyzer.inspectionResults && viewItem == problem",
          "group": "inline@1"
        },
        {
          "command": "scalaAnalyzer.suppressInspection",
          "when": "view == scalaAnalyzer.inspectionResults && viewItem == problem",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "scalaAnalyzer.applyInspectionFix",
          "when": "false"
        },
        {
          "command": "scalaAnalyzer.suppressInspection",
          "when": "false"
        },
        {
          "command": "scalaAnalyzer.typeInfo",
          "when": "editorLangId == scala"
        },
        {
          "command": "scalaAnalyzer.goToSuper",
          "when": "editorLangId == scala"
        },
        {
          "command": "scalaAnalyzer.goToTest",
          "when": "editorLangId == scala"
        },
        {
          "command": "scalaAnalyzer.chooseMembersToOverride",
          "when": "editorLangId == scala"
        },
        {
          "command": "scalaAnalyzer.compileTarget",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "scalaAnalyzer.toggleXRay",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x",
        "when": "editorTextFocus && editorLangId == scala"
      }
    ],
    "commands": [
      {
        "command": "scalaAnalyzer.menu",
        "title": "Show Menu",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.compile",
        "title": "Compile Build",
        "category": "scala-analyzer",
        "icon": "$(tools)"
      },
      {
        "command": "scalaAnalyzer.compileTarget",
        "title": "Compile Target",
        "category": "scala-analyzer",
        "icon": "$(tools)"
      },
      {
        "command": "scalaAnalyzer.reimport",
        "title": "Reimport Build",
        "category": "scala-analyzer",
        "icon": "$(sync)"
      },
      {
        "command": "scalaAnalyzer.inspect",
        "title": "Inspect Code",
        "category": "scala-analyzer",
        "icon": "$(search)"
      },
      {
        "command": "scalaAnalyzer.clearInspection",
        "title": "Clear Inspection Results",
        "category": "scala-analyzer",
        "icon": "$(clear-all)"
      },
      {
        "command": "scalaAnalyzer.applyInspectionFix",
        "title": "Apply Fix",
        "category": "scala-analyzer",
        "icon": "$(wrench)"
      },
      {
        "command": "scalaAnalyzer.suppressInspection",
        "title": "Suppress Inspection",
        "category": "scala-analyzer",
        "icon": "$(eye-closed)"
      },
      {
        "command": "scalaAnalyzer.restart",
        "title": "Restart Server",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.typeInfo",
        "title": "Show Type Info",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.goToSuper",
        "title": "Go to Super",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.goToTest",
        "title": "Go to Test",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.chooseMembersToOverride",
        "title": "Override Members…",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.toggleXRay",
        "title": "Toggle X-Ray",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.showStatus",
        "title": "Show Status",
        "category": "scala-analyzer"
      },
      {
        "command": "scalaAnalyzer.showLog",
        "title": "Show Log File",
        "category": "scala-analyzer"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0"
  },
  "scripts": {
    "check": "node --check extension.js && node --check buildTargets.js && node --check inspect.js && node --check inspectionTree.js",
    "package": "vsce package",
    "test:installed": "node test/run.js"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
